NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dónde guardar el estado: supabase | file (.data/*.json). Vacío = supabase si hay service_role.
STORE_BACKEND=
# Basic Auth del servidor (obligatorio al exponer la app). Vacío = sin auth (local).
APP_USER=
APP_PASSWORD=
CRON_SECRET=

# Sincronización automática interna (instrumentation.ts → lib/jobs/scheduler.ts)
CRON_ENABLED=
CRON_INTERVAL_MINUTES=5
CRON_FROM=8
CRON_TO=21
CRON_FAST_INTERVAL_MINUTES=2
CRON_FAST_MINUTES=40
CRON_DRAFTS_AT=08:30
# Lunes: análisis semanal con IA de las cuentas asignadas y resumen de la semana (borrador en Gmail a mí mismo).
CRON_ANALYSIS_AT=07:00
CRON_DIGEST_AT=08:00
# Resumen de la semana: send (default, llega a mi bandeja) | draft (queda en Borradores). Solo a mi correo.
WEEKLY_DIGEST=send
# URL de la app para los links del resumen (p. ej. http://localhost:3000).
APP_URL=
# En un servidor: zona horaria para el horario del scheduler
# TZ=America/Santiago

# Google OAuth (Gmail + Calendar + Drive para Gemini Notes) — Fase 1.5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Notion (cuentas asignadas) — Etapa 2. Solo lectura.
# Opción A (recomendada): OAuth → GET /api/auth/notion/connect
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback
# Opción B: token de integración interna
NOTION_TOKEN=
NOTION_ACCOUNTS_DB_ID=
# Nombres EXACTOS de las propiedades de la base (como aparecen en Notion)
NOTION_PROP_NAME=Name
NOTION_PROP_SPECIALIST=
NOTION_PROP_DOMAIN=
NOTION_PROP_STAGE=
# Cómo apareces tú en la columna del specialist (nombre, email o texto del select)
NOTION_SPECIALIST_VALUE=
